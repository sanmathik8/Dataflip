{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::dataflip-analytics-*",
        "arn:aws:s3:::dataflip-analytics-*/*"
      ]
    },
    {
      "Sid": "GlueCatalogUpdateAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:UpdateTable",
        "glue:GetDatabase"
      ],
      "Resource": [
        "arn:aws:glue:*:*:catalog",
        "arn:aws:glue:*:*:database/dataflip_db",
        "arn:aws:glue:*:*:table/dataflip_db/sales_curated"
      ]
    },
    {
      "Sid": "CloudWatchLoggingAccess",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/dataflip-processor:*"
    }
  ]
}
